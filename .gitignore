# VCR global .gitignore — JS, Astro, PHP, Laravel, macOS, Linux, Windows
# Use project-specific additions as needed; do not remove entries that protect secrets or build artifacts.

# -----------------------------------------------------------------------------
# macOS
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
*~

# -----------------------------------------------------------------------------
# Linux
# -----------------------------------------------------------------------------
.directory
.Trash-*
.nfs*

# -----------------------------------------------------------------------------
# Windows
# -----------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# -----------------------------------------------------------------------------
# Environment and secrets (all stacks)
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/
*.secret

# -----------------------------------------------------------------------------
# Node / JavaScript / Bun / npm / yarn / pnpm
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
.yarn/
.pnp.*
dist/
build/
.next/
.nuxt/
.output/
.cache/
*.tsbuildinfo
.parcel-cache/
.turbo/
.vercel/
.serverless/
.eslintcache
.stylelintcache
coverage/
.nyc_output/

# -----------------------------------------------------------------------------
# Astro
# -----------------------------------------------------------------------------
.astro/
dist/

# -----------------------------------------------------------------------------
# PHP / Laravel / Composer
# -----------------------------------------------------------------------------
vendor/
.phpunit.result.cache
.phpunit.cache
phpunit.xml.bak
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*
!storage/logs/.gitkeep
!storage/framework/cache/.gitkeep
!storage/framework/sessions/.gitkeep
!storage/framework/views/.gitkeep
!bootstrap/cache/.gitkeep
.env.backup
.phpunit.result.cache
Homestead.json
Homestead.yaml
auth.json
*.php.swp

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.Python
venv/
.venv/
env/
.env/
*.egg-info/
.eggs/
dist/
build/
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# -----------------------------------------------------------------------------
# Go
# -----------------------------------------------------------------------------
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
/vendor/

# -----------------------------------------------------------------------------
# Editors & IDEs
# -----------------------------------------------------------------------------
# VS Code
.vscode/

# Cursor (keep agent rules)
.cursor/
!.cursor/rules/

# JetBrains (WebStorm, PhpStorm, IntelliJ)
.idea/
*.iml

# Zed
.zed/

# Neovim / Vim
*.swp
*.swo
*.swn
.nvim/
.vim/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Emacs
\#*\#
.dir-locals.el

# Windsurf
.windsurf/

# -----------------------------------------------------------------------------
# Build / test / tooling
# -----------------------------------------------------------------------------
*.log
.cache/
tmp/
temp/
*.tmp
*.temp
*.bak
*.backup

# -----------------------------------------------------------------------------
# Docker (local overrides, not images)
# -----------------------------------------------------------------------------
docker-compose.override.yml
.docker/

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
*.orig
*.rej
.sass-cache/

