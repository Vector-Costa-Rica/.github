# ═══════════════════════════════════════════════════════════════
# VCR Standard .gitignore — Vector Costa Rica
# ═══════════════════════════════════════════════════════════════

# Dependencies
node_modules/
vendor/
.bun/

# Build output
dist/
build/
.output/

# Astro
.astro/

# Vite cache
node_modules/.vite/

# ── Environment files ──
# Local dev env (NEVER commit)
.env
.env.local
.env.*.local

# dotenvx private keys (NEVER commit)
.env.keys

# Allow encrypted/committed env files
!.env.production
!.env.development
!.env.example

# ── IDE & OS ──
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Logs ──
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ── Testing ──
coverage/
test-results/
test-results.json
playwright-report/
blob-report/

# ── Docker ──
docker-compose.override.yml

# ── Misc ──
*.pid
*.seed
.npmrc
.superpowers/
